{
  "CallerReference": "__CALLER_REF__",
  "Comment": "my-app: S3 (React) + Elastic Beanstalk (.NET API)",
  "Enabled": true,
  "DefaultRootObject": "index.html",
  "HttpVersion": "http2and3",
  "IsIPV6Enabled": true,
  "Origins": {
    "Quantity": 2,
    "Items": [
      {
        "Id": "s3-react",
        "DomainName": "__WEB_BUCKET__.s3.__REGION__.amazonaws.com",
        "OriginAccessControlId": "__OAC_ID__",
        "S3OriginConfig": {
          "OriginAccessIdentity": ""
        }
      },
      {
        "Id": "eb-api",
        "DomainName": "__EB_CNAME__",
        "CustomOriginConfig": {
          "HTTPPort": 80,
          "HTTPSPort": 443,
          "OriginProtocolPolicy": "http-only",
          "OriginSslProtocols": {
            "Quantity": 1,
            "Items": ["TLSv1.2"]
          }
        }
      }
    ]
  },
  "OriginGroups": {
    "Quantity": 0
  },
  "DefaultCacheBehavior": {
    "TargetOriginId": "s3-react",
    "ViewerProtocolPolicy": "redirect-to-https",
    "Compress": true,
    "CachePolicyId": "__POL_CACHE__"
  },
  "CacheBehaviors": {
    "Quantity": 1,
    "Items": [
      {
        "PathPattern": "api/*",
        "TargetOriginId": "eb-api",
        "ViewerProtocolPolicy": "redirect-to-https",
        "Compress": true,
        "CachePolicyId": "__POL_NOCACHE__",
        "OriginRequestPolicyId": "__POL_ORQ__"
      }
    ]
  },
  "PriceClass": "PriceClass_100"
}
