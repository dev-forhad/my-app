# Force LF for everything GitHub Actions / Linux servers executes.
# Windows checkouts keep working; bash scripts and YAML just must not get CRLF.
* text=auto
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.jsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
Dockerfile text eol=lf
