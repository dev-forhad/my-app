<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keeps the Alpine Docker image small (no ICU locale data needed). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>

  <!-- Web-SDK projects compile every .cs below them by default; keep the test
       project out of the API compilation (it is built via Api.sln instead). -->
  <ItemGroup>
    <Compile Remove="Api.Tests\**" />
    <Content Remove="Api.Tests\**" />
    <EmbeddedResource Remove="Api.Tests\**" />
    <None Remove="Api.Tests\**" />
  </ItemGroup>

</Project>
